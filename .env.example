# Copy to .env  ->  copy .env.example .env
# CLEARANCE runs with ZERO keys. These are only needed to record NEW fixtures
# or to hit a live model. Offline replay never reads them.

# OpenAI-compatible endpoint (AI Pipe). Never hardcode a token in source.
AIPIPE_BASE_URL=https://aipipe.org/openai/v1
AIPIPE_TOKEN=

# Upstream model the gateway proxies to when NOT serving from fixtures.
CLEARANCE_MODEL=gpt-4o-mini

# 1 = never touch the network; raise a clear error on fixture cache miss.
# The judge path (scripts/run_replay.py --offline) forces this on.
CLEARANCE_OFFLINE=1
